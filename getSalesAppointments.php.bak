	}else{
                $url = "$api_endpoint/lp/getApptSchedule.php?start=$date&end=$date";
                $found = 'false';
                $attempts = 0;

                while($found == 'false' && $attempts < 5){
                        $attempts++;
                        $response = curlCall($url);
                        if(is_array($response) && count($response) > 0){
                                $found = 'true';
                                $apptSchedule = $response;
                                break;
                        }
                }
	}


	$dateTime = strtotime($date);
