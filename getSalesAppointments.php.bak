                                $end = date('H:i',strtotime($end.' + 1 hour'));
                        }
                }

		$start = strtotime("$startDate $time");
		$end = strtotime("$endDate $end");
		$takenTimes = array();
		foreach($times as $possible){
			if(($possible['start'] <= $start && $start < $possible['end']) || ($possible['start'] < $end && $end <= $possible['end']) || ($start < $possible['start'] && $possible['end'] < $end)){
				$takenTimes[] = $possible['start'];
			}
		}
		if($apptType == 'background'){
			$availible[$time][] = $appt['salesrepname'];
                }
		if($productID != 'driveTime' && $apptType != 'background'){
			foreach($takenTimes as $time){
				$time = date('H:i',$time);
		                $appointments[$time][$productID][] = array($appt['salesrepname'],'source'=>array('source'=>$source,'sub'=>$sub));
			}
		}
        }
	ksort($appointments);


