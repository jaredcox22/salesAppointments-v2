                $time = date('H:i',strtotime($appt['start']));
		if($daylightSavings == '0' || ($daylightSavings == '1' && date('w',strtotime($startDate)) == 6)){
			if($time == '13:00' || $time == '16:00' || $time == '19:00'){
				$time = date('H:i',strtotime($time.' - 1 hour'));
			}
		}elseif($daylightSavings == '1'){
			if($time == '12:00' || $time == '15:00' || $time == '18:00'){
                                $time = date('H:i',strtotime($time.' + 1 hour'));
                        }
		}
		$endDate = date("Y-m-d",strtotime($appt['end']));
		$end = date('H:i',strtotime($appt['end']));
		if($daylightSavings == '0'  || ($daylightSavings == '1' && date('w',strtotime($endDate)) == 6)){
                        if($end == '13:00' || $end == '16:00' || $end == '19:00'){
                                $end = date('H:i',strtotime($end.' - 1 hour'));
                        }
